pragma cashscript ^0.14.0;

// RewardVault3 = RewardVault2 for dated stamps (StampMinter4) + streak(): stamps from consecutive days pay a streak reward.
// claim(), the bonus tier and merge() work as in RewardVault2, on 23-byte dated stamps. No addStall() here: a streak
// rally's stalls are fixed at genesis (adding one would need the StampMinter4 template; left for later).
contract RewardVault3(bytes32 rallyCategory, int needed, int reward, int bonusNeeded, int bonusReward, int streakDays, int streakReward, pubkey organizer, int endTime) {
    function claim() {
        require(this.activeInputIndex == 0);

        int n = needed;
        int pay = reward;
        bytes tier = 0x; // bonus claims mint a bonus trophy: 0x00 ‖ pkh ‖ 0x02
        if (bonusNeeded > needed) {
            if (tx.inputs.length > bonusNeeded) {
                if (tx.inputs[bonusNeeded].tokenCategory == rallyCategory) {
                    n = bonusNeeded;
                    pay = bonusReward;
                    tier = 0x02;
                }
            }
        }

        bytes20 buyer = unsafe_bytes20(tx.inputs[1].nftCommitment.split(1)[1].split(20)[0]);
        int prev = 0;
        for (int i = 1; i <= n; i++) {
            require(tx.inputs[i].tokenCategory == rallyCategory);
            bytes commitment = tx.inputs[i].nftCommitment;
            require(commitment.length == 23); // dated stamps: id ‖ pkh ‖ day
            int id = int(commitment.split(1)[0]);
            require(id > prev);
            prev = id;
            require(unsafe_bytes20(commitment.split(1)[1].split(20)[0]) == buyer);
        }

        // vault continues with its minting NFT, paying out exactly one reward
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].nftCommitment == tx.inputs[0].nftCommitment);
        require(tx.outputs[0].value == tx.inputs[0].value - pay);

        bytes buyerLock = new LockingBytecodeP2PKH(buyer);
        require(tx.outputs[1].lockingBytecode == buyerLock);
        require(tx.outputs[1].value >= pay);
        require(tx.outputs[1].tokenCategory == 0x);

        require(tx.outputs[2].lockingBytecode == buyerLock);
        require(tx.outputs[2].tokenCategory == rallyCategory);
        require(tx.outputs[2].nftCommitment == 0x00 + buyer + tier);

        for (int o = 3; o < tx.outputs.length; o++) {
            require(tx.outputs[o].tokenCategory == 0x);
        }
    }

    // Streak: burn `streakDays` dated stamps from consecutive days (any stalls, the same buyer, in day order)
    // -> `streakReward` and a streak trophy 0x00 ‖ pkh ‖ 0x03 (a member card too: the minters accept 0x00 ‖ pkh ‖ any tier).
    //   in[0] this vault -> out[0] this vault minus exactly streakReward
    //   in[1..streakDays] dated stamps -> out[1] reward to their buyer, out[2] the streak trophy, then BCH-only change
    // Collusion-proof like the set reward: the opener checks streakDays * levy >= streakReward.
    function streak() {
        require(this.activeInputIndex == 0);
        require(streakDays > 1);
        bytes20 buyer = unsafe_bytes20(tx.inputs[1].nftCommitment.split(1)[1].split(20)[0]);
        int prevDay = 0;
        for (int i = 1; i <= streakDays; i++) {
            require(tx.inputs[i].tokenCategory == rallyCategory);
            bytes c = tx.inputs[i].nftCommitment;
            require(c.length == 23);
            require(int(c.split(1)[0]) > 0); // a stamp, not a trophy
            require(unsafe_bytes20(c.split(1)[1].split(20)[0]) == buyer);
            int day = int(c.split(21)[1]);
            if (i > 1) {
                require(day == prevDay + 1);
            }
            prevDay = day;
        }

        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].nftCommitment == tx.inputs[0].nftCommitment);
        require(tx.outputs[0].value == tx.inputs[0].value - streakReward);

        bytes buyerLock = new LockingBytecodeP2PKH(buyer);
        require(tx.outputs[1].lockingBytecode == buyerLock);
        require(tx.outputs[1].value >= streakReward);
        require(tx.outputs[1].tokenCategory == 0x);

        require(tx.outputs[2].lockingBytecode == buyerLock);
        require(tx.outputs[2].tokenCategory == rallyCategory);
        require(tx.outputs[2].nftCommitment == 0x00 + buyer + 0x03);

        for (int o = 3; o < tx.outputs.length; o++) {
            require(tx.outputs[o].tokenCategory == 0x);
        }
    }

    // Anyone can fold the levy coins sitting at this address into the vault coin, no signature needed.
    // Every input runs this: all inputs are this vault, in[0] is the vault coin with the minting NFT, and the
    // single output is the vault again, holding everything minus a per-input fee. So levies can only grow the pool.
    function merge() {
        bytes vaultLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        require(tx.inputs[0].lockingBytecode == vaultLock);
        require(tx.inputs[0].tokenCategory == rallyCategory + 0x02);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].lockingBytecode == vaultLock);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].nftCommitment == tx.inputs[0].nftCommitment);
        int total = 0;
        for (int i = 0; i < tx.inputs.length; i++) {
            require(tx.inputs[i].lockingBytecode == vaultLock);
            total = total + tx.inputs[i].value;
        }
        require(tx.outputs[0].value >= total - 1000 * tx.inputs.length); // each input reveals the ~740-byte redeem script
        // the fee comes out of the levies, never out of the pool: a merge can't shrink the vault coin
        // (without this, merging the vault coin with nothing would burn 600 sats per call, over and over)
        require(tx.outputs[0].value >= tx.inputs[0].value);
    }

    // after the rally ends the organizer takes back what is left
    function reclaim(sig organizerSig) {
        require(tx.time >= endTime);
        require(checkSig(organizerSig, organizer));
    }
}
