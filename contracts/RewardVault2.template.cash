pragma cashscript ^0.14.0;

// RewardVault2 = RewardVault + merge(): levy coins that StampMinter3 sends to this address are folded into the pool.
// Holds a rally's BCH reward pool plus one minting NFT of the rally category.
// Burn a full set of stamps -> get the reward and a Trophy NFT (same category, merchant id 0x00).
//
//   in[0]          this vault     -> out[0] this vault: same token, value minus exactly one reward
//   in[1..needed]  stamps, merchant ids strictly increasing (= all different),
//                  all minted to the same buyer pkh (bought, not traded)
//                                 -> out[1] reward, to the stamps' original buyer
//                                 -> out[2] Trophy NFT (commitment 0x00 + buyer pkh), to the same buyer
//   in[needed+1+]  fee coins      -> out[3+] BCH-only change
// Stamps are burned: no other output may carry any token.
// Anti-farming invariant, checked by the deploy script: reward < sum of every merchant's price.
// Tiers: burn `bonusNeeded` stamps from different stalls (more than `needed`) for `bonusReward` instead.
// The claim is a bonus claim exactly when input `bonusNeeded` is also a rally token; bonusNeeded = 0 turns tiers off.
// addStall(): the organizer opens a new stall mid-rally. The vault builds the new minter's address itself from the
// StampMinter3 bytecode (MINTER_TEMPLATE, filled in by scripts/gen-vault.mjs) and the stall's parameters, so its minting
// NFT can only go to a real stamp minter of this rally, with this rally's levy: never to the organizer.
//
// GENERATED from contracts/RewardVault2.template.cash by scripts/gen-vault.mjs: edit the template, not this file.
contract RewardVault2(bytes32 rallyCategory, int needed, int reward, int bonusNeeded, int bonusReward, int levy, pubkey organizer, int endTime) {
    function claim() {
        require(this.activeInputIndex == 0);

        int n = needed;
        int pay = reward;
        bytes tier = 0x; // bonus claims mint a bonus trophy: 0x00 ‖ pkh ‖ 0x02
        if (bonusNeeded > needed) {
            if (tx.inputs.length > bonusNeeded) {
                if (tx.inputs[bonusNeeded].tokenCategory == rallyCategory) {
                    n = bonusNeeded;
                    pay = bonusReward;
                    tier = 0x02;
                }
            }
        }

        bytes20 buyer = unsafe_bytes20(tx.inputs[1].nftCommitment.split(1)[1]);
        int prev = 0;
        for (int i = 1; i <= n; i++) {
            require(tx.inputs[i].tokenCategory == rallyCategory);
            bytes commitment = tx.inputs[i].nftCommitment;
            require(commitment.length == 21);
            int id = int(commitment.split(1)[0]);
            require(id > prev);
            prev = id;
            require(unsafe_bytes20(commitment.split(1)[1]) == buyer);
        }

        // vault continues with its minting NFT, paying out exactly one reward
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].nftCommitment == tx.inputs[0].nftCommitment);
        require(tx.outputs[0].value == tx.inputs[0].value - pay);

        bytes buyerLock = new LockingBytecodeP2PKH(buyer);
        require(tx.outputs[1].lockingBytecode == buyerLock);
        require(tx.outputs[1].value >= pay);
        require(tx.outputs[1].tokenCategory == 0x);

        require(tx.outputs[2].lockingBytecode == buyerLock);
        require(tx.outputs[2].tokenCategory == rallyCategory);
        require(tx.outputs[2].nftCommitment == 0x00 + buyer + tier);

        for (int o = 3; o < tx.outputs.length; o++) {
            require(tx.outputs[o].tokenCategory == 0x);
        }
    }

    // Anyone can fold the levy coins sitting at this address into the vault coin, no signature needed.
    // Every input runs this: all inputs are this vault, in[0] is the vault coin with the minting NFT, and the
    // single output is the vault again, holding everything minus a per-input fee. So levies can only grow the pool.
    function merge() {
        bytes vaultLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        require(tx.inputs[0].lockingBytecode == vaultLock);
        require(tx.inputs[0].tokenCategory == rallyCategory + 0x02);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].lockingBytecode == vaultLock);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].nftCommitment == tx.inputs[0].nftCommitment);
        int total = 0;
        for (int i = 0; i < tx.inputs.length; i++) {
            require(tx.inputs[i].lockingBytecode == vaultLock);
            total = total + tx.inputs[i].value;
        }
        require(tx.outputs[0].value >= total - 1000 * tx.inputs.length); // each input reveals the ~740-byte redeem script
        // the fee comes out of the levies, never out of the pool: a merge can't shrink the vault coin
        // (without this, merging the vault coin with nothing would burn 600 sats per call, over and over)
        require(tx.outputs[0].value >= tx.inputs[0].value);
    }

    // A stall added mid-rally: ids 17..127, prices above 16 sats and a P2PKH payout keep every push in the minter's
    // redeem script a plain length-prefixed push, so this byte layout always equals what CashScript builds.
    // Two minter lanes come out at out[1] and out[2]; the vault itself is unchanged. Fees come from the organizer's coins.
    function addStall(sig organizerSig, bytes25 merchantLock, int price, int memberPrice, int id, bytes presenceKey) {
        require(this.activeInputIndex == 0);
        require(checkSig(organizerSig, organizer));
        require(merchantLock == new LockingBytecodeP2PKH(unsafe_bytes20(merchantLock.split(3)[1].split(20)[0])));
        require(id >= 17);
        require(id <= 127);
        require(price > 16);
        require(memberPrice > 16);
        require(memberPrice <= price);

        bytes presencePush = 0x00; // OP_0: no proof of presence
        if (presenceKey.length > 0) {
            require(presenceKey.length == 33);
            presencePush = 0x21 + presenceKey;
        }
        bytes vaultLock = tx.inputs[0].lockingBytecode;
        bytes levyBytes = unsafe_bytes(levy);
        bytes memberBytes = unsafe_bytes(memberPrice);
        bytes priceBytes = unsafe_bytes(price);
        // StampMinter3(merchantLock, minPrice, memberPrice, merchantId, vaultLock, levy, presenceKey): args pushed in reverse
        bytes redeem = presencePush
            + toPaddedBytes(levyBytes.length, 1) + levyBytes
            + 0x23 + vaultLock
            + 0x01 + toPaddedBytes(id, 1)
            + toPaddedBytes(memberBytes.length, 1) + memberBytes
            + toPaddedBytes(priceBytes.length, 1) + priceBytes
            + 0x19 + merchantLock
            + MINTER_TEMPLATE;
        bytes minterLock = new LockingBytecodeP2SH32(hash256(redeem));

        require(tx.outputs[0].lockingBytecode == vaultLock);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].nftCommitment == tx.inputs[0].nftCommitment);
        require(tx.outputs[0].value == tx.inputs[0].value);
        for (int o = 1; o <= 2; o++) {
            require(tx.outputs[o].lockingBytecode == minterLock);
            require(tx.outputs[o].tokenCategory == tx.inputs[0].tokenCategory);
            require(tx.outputs[o].nftCommitment == 0x);
        }
        for (int o = 3; o < tx.outputs.length; o++) {
            require(tx.outputs[o].tokenCategory == 0x);
        }
    }

    // after the rally ends the organizer takes back what is left
    function reclaim(sig organizerSig) {
        require(tx.time >= endTime);
        require(checkSig(organizerSig, organizer));
    }
}
