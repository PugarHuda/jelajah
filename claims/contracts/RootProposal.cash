pragma cashscript ^0.14.0;

// A proposed earned root waits here (an immutable NFT of the proposal category, commitment = root)
// for `delay` blocks, so watchers can recompute it from the public F@H data and raise the alarm.
contract RootProposal(int delay, pubkey operator, bytes32 keeperCategory) {
    // only next to the keeper (the sole mutable NFT of this category), only after the delay
    function activate() {
        require(this.age >= delay);
        require(this.activeInputIndex == 1);
        require(tx.inputs[0].tokenCategory == keeperCategory + 0x01);
    }

    // the operator withdraws a bad proposal before it matures
    function cancel(sig operatorSig) {
        require(checkSig(operatorSig, operator));
    }
}
